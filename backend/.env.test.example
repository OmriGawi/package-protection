# The database the test suite runs against. Copy to `.env.test`.
#
# Only needed when the suite would otherwise share a database with your
# development data — which is the case wherever Postgres is a shared instance
# rather than a throwaway container. With `docker compose up -d`, skip this
# file entirely: the suite uses `.env` and the container holds nothing you mind
# losing.
#
# The suite creates and deletes rows continuously, so this must never point at
# a database anyone else is reading.

# A separate database on the same server, if you have rights to create one:
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/package_protection_test"

# Or a separate schema in the database you already have, which needs only
# CREATE on that database. `prisma migrate deploy` builds the tables inside it:
# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>?schema=<your>_test"
