# The database the test suite runs against. Copy to `.env.test`.
#
# Copy it on every machine, including one running the throwaway container.
# Sharing a database with your development data does not only risk a database
# someone else is reading — the suite creates and deletes rows continuously, so
# a run empties the seeded deliveries out from under whatever screen you had
# open and leaves a few hundred fixtures in their place. Reseeding afterwards
# restores the seeded rows and nothing else.
#
# A separate schema in the container's own database needs no extra setup;
# `npx prisma migrate deploy` builds the tables inside it, and vitest loads
# this file ahead of `.env`, so the separation is a file rather than a habit.
DATABASE_URL="postgresql://package_protection:package_protection@localhost:5432/package_protection?schema=test"

# On a shared Postgres, name a schema of your own so two people's runs cannot
# collide, and never point this at a database anyone else is reading:
# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>?schema=<your>_test"

# Or a separate database entirely, where you have rights to create one:
# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/package_protection_test"
