{
  "compilerOptions": {
    "target": "ES2022",
    // "nodenext" rather than the deprecated "node" (renamed "node10" in TS 5.x,
    // and slated for removal): it resolves the way Node actually does. The
    // package is "type": "commonjs", so this still emits CommonJS.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  // Everything under src, tests included, so the editor and `npm run
  // typecheck` cover them. The build narrows this — see tsconfig.build.json.
  "include": ["src"]
}
