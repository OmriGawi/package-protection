generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Direction {
  EXPORT
  IMPORT
}

enum DeliveryStatus {
  SUBMITTED
}

// Full lifecycle per DESIGN.md §3. Only SHIPPED is reachable in this slice —
// CHECKING / RECEIVED / CHECK_FAILED arrive with receiving (Slice 3), but are
// defined now so that doesn't need a second enum migration.
enum WorkflowStatus {
  PRE_SHIP_UPLOADED
  SHIPPED
  CHECKING
  RECEIVED
  CHECK_FAILED
}

enum Verdict {
  INTACT
  OPENED
  INCONCLUSIVE
}

enum VerdictSource {
  API
  MANUAL
}

enum Phase {
  PRE_SHIP
  POST_RECEIVE
}

model Delivery {
  id              String         @id @default(uuid())
  internalNumber  Int            @unique @default(autoincrement())
  // One submit attempt's key, so a retry after a timeout replays the original
  // delivery instead of creating a second one for the same physical boxes
  // (docs/production-readiness.md P8). Nullable: a request without the header
  // is still accepted, and every historic row predates it.
  idempotencyKey  String?        @unique
  direction       Direction
  referenceNumber String
  status          DeliveryStatus @default(SUBMITTED)
  createdBy       String
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  packages Package[]
}

model Package {
  id             String         @id @default(uuid())
  deliveryId     String
  delivery       Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  // Handwritten on the physical box, so unique within its delivery only —
  // not globally (DESIGN.md §3).
  label          Int
  workflowStatus WorkflowStatus @default(SHIPPED)

  verdict       Verdict?
  verdictSource VerdictSource?

  verdictOverriddenBy String?
  overriddenAt        DateTime? @db.Timestamptz(3)
  overrideNote        String?

  images PackageImage[]
  checks TamperCheck[]

  @@unique([deliveryId, label])
  // The dashboard filters on these (services/packageQuery.ts) and startup
  // recovery scans workflowStatus. Its priority ORDER BY is a CASE expression
  // and stays unindexable — see P18 in docs/production-readiness.md.
  //
  // The verdict index is composite because no query asks for a verdict alone:
  // every one pairs it with a workflow predicate, since a failed call is the
  // state the row is in whatever stale verdict it still carries.
  @@index([workflowStatus])
  @@index([verdict, workflowStatus])
}

enum CheckStatus {
  PENDING
  COMPLETE
  ERROR
}

// One row per attempt at the tamper-detection call, so a retry after a failed
// call leaves an audit trail rather than overwriting one (DESIGN.md §3).
model TamperCheck {
  id        String  @id @default(uuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  // Null while PENDING, and on ERROR — a failed call produced no verdict.
  verdict Verdict?
  // Unknown whether the real API exposes a score; kept so a future
  // score → INTACT/OPENED/INCONCLUSIVE threshold has somewhere to live (§3).
  confidenceScore Float?
  // Whatever the API returned, stored verbatim.
  rawResponse Json?

  status      CheckStatus @default(PENDING)
  requestedAt DateTime    @default(now()) @db.Timestamptz(3)
  completedAt DateTime?   @db.Timestamptz(3)

  // packageId: for the cascade when a Delivery is deleted, which would
  // otherwise scan the whole table per package, and for the audit-trail read
  // this row exists to make possible — nothing queries it that way yet.
  //
  // status: recoverInterruptedChecks scans for PENDING on every boot, and this
  // table gains a row per attempt and is never pruned, so that scan is the one
  // here that grows without bound.
  @@index([packageId])
  @@index([status])
}

model PackageImage {
  id          String   @id @default(uuid())
  packageId   String
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  phase       Phase
  // Opaque to us — whatever the StorageClient handed back. Local disk today,
  // an internal storage service in production (DESIGN.md §7).
  storagePath String
  uploadedBy  String
  uploadedAt  DateTime @default(now()) @db.Timestamptz(3)
  sequence    Int

  // Composite rather than packageId alone: every read of a package's photos
  // filters by packageId and orders by sequence (IMAGE_SELECT, and the check's
  // own read in tamperCheckService), so one index serves both halves.
  @@index([packageId, sequence])
}
