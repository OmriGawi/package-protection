DATABASE_URL="postgresql://package_protector:package_protector@localhost:5432/package_protector"
PORT=4000

# development | test | production. Production is stricter: CORS_ORIGIN becomes
# required, and the process refuses to start on a mocked tamper-detection
# client (see src/index.ts).
NODE_ENV=development

# Comma-separated browser origins allowed to call this API. Empty means "any",
# which only development gets.
CORS_ORIGIN=http://localhost:5173

# How many proxies sit in front of this process. Decides what req.ip is, and so
# what the rate limiter counts: left at 0 behind an ingress, every caller looks
# like the ingress and the whole deployment shares one bucket. Required in
# production. Prefer a hop count over `true`, which trusts a header the client
# can write.
TRUST_PROXY=false

# Where LocalDiskStorage writes photos. Defaults to backend/storage.
# STORAGE_DIR=

# Requests per window, keyed by address until there is an authenticated user.
# Defaults to on outside tests.
# RATE_LIMIT_ENABLED=true

# How long SIGTERM waits for in-flight requests before forcing exit.
# SHUTDOWN_GRACE_MS=10000

# Largest JSON body accepted. Photo uploads are multipart and capped separately.
# JSON_BODY_LIMIT=100kb

# Pins the dummy tamper-detection result, for demoing a specific state.
# The mock never looks at the photos, so uploading the same images twice
# still draws at random unless this is set.
# One of: INTACT | OPENED | INCONCLUSIVE | CALL_FAILED | RANDOM (default)
TAMPER_CHECK_OUTCOME=RANDOM
